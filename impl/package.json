{
  "name": "verified-approval-workflow-impl",
  "version": "0.1.0",
  "private": true,
  "description": "Approval workflow on the Cedar policy engine, tested against a Lean model",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-policies.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:diff": "node test/differential/run.ts",
    "test:mutants": "node test/differential/mutants.ts",
    "test": "npm run typecheck && npm run validate && npm run test:unit && npm run test:diff"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "fast-check": "4.10.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
